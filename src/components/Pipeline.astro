---
// Slim "where am I" row: stage names in a line, current ones lit, plus "3 / 7" section position (see lesson-client.ts).
interface Props { stages: string[] }
const { stages } = Astro.props;
---
<nav class="pipe" aria-label="Pipeline">
  <div class="pipe-row">
    {stages.map((s, i) => (
      <>
        {i > 0 && <span class="arr">›</span>}
        <span class="box" data-stage={s}>{s}</span>
      </>
    ))}
  </div>
  <span class="pos" aria-label="Section"></span>
</nav>
