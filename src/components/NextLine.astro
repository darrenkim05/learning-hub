---
// "Choose the next line" of a derivation. Slot = the lines so far. Options: {tex, ok?, why}; wrong ones are common errors.
import { ctx, need } from '../lib/lessons';
import { inlineTex, displayTex } from '../lib/tex';
interface Props { id: string; concept: string; options: { tex: string; ok?: boolean; why: string }[] }
const { id, concept, options } = Astro.props;
const L = ctx(Astro.locals);
need('concept', concept, L.concepts, L.slug);
if (options.filter((o) => o.ok).length !== 1) throw new Error(`[${L.slug}] NextLine "${id}" needs exactly one ok option`);
---
<div class="qz" data-kind="nextline" data-q={id} data-concept={`${L.slug}/${concept}`} data-attempted="0">
  <div class="qz-q"><slot /><p class="qz-ask"><b>Which line comes next?</b></p></div>
  <div class="qz-opts">
    {options.map((o, i) => (
      <div class="qz-opt" data-i={i} data-ok={o.ok ? '1' : '0'}>
        <button type="button" class="qz-pick" set:html={displayTex(o.tex)} />
        <div class="qz-why" hidden set:html={inlineTex(o.why)} />
      </div>
    ))}
  </div>
  <div class="qz-bar">
    <button type="button" class="qz-show">Just show me</button>
    <button type="button" class="qz-retry" hidden>Try again</button>
  </div>
</div>
